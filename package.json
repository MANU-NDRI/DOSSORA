{
  "name": "dossora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DOSSORA — L'élégance à votre portée. Boutique e-commerce internationale (React + Supabase).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "demo:generate": "node scripts/generate-demo.mjs",
    "i18n:check": "node scripts/i18n-keys.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "db:types": "node scripts/gen-db-types.mjs",
    "check": "npm run db:types -- --check && npm run i18n:check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "framer-motion": "^11.11.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.9",
    "tailwindcss": "3.4.19",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "5.0.3"
  }
}
